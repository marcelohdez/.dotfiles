{
  "spacing": 0,
  "layer": "top",
  "position": "top",
  "modules-left": [
    "group/group-power",
    "niri/workspaces",
    "idle_inhibitor",
    "privacy"
  ],
  "modules-center": ["mpris"],
  "modules-right": [
    "tray",
    "group/group-toggles",
    "pulseaudio",
    "bluetooth",
    "network",
    "upower",
    "custom/dnd",
    "clock"
  ],
  "group/group-power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "children-class": "not-power"
    },
    "modules": [
      "custom/power-logo",
      "custom/lock",
      "custom/suspend",
      "custom/reboot",
      "custom/power",
      "custom/logout"
    ]
  },
  "custom/power-logo": {
    "format": "󰣛",
    "tooltip-format": "Power menu"
  },
  "custom/lock": {
    "format": "",
    "tooltip-format": "Lock",
    "on-click": "loginctl lock-session"
  },
  "custom/suspend": {
    "format": "",
    "tooltip-format": "Suspend",
    "on-click": "loginctl lock-session && systemctl suspend"
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip-format": "Reboot",
    "on-click": "~/.local/share/fn-scripts/action_notif.sh 'Reboot' 'Rebooting' 'reboot'"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power off",
    "on-click": "~/.local/share/fn-scripts/action_notif.sh 'Power off' 'Shutting down' 'shutdown now'"
  },
  "custom/logout": {
    "format": "󰍃",
    "tooltip-format": "Log out",
    "on-click": "~/.local/share/fn-scripts/action_notif.sh 'Log out' 'Logging out' \"loginctl terminate-user $USER\""
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Auto-suspend: off",
    "tooltip-format-deactivated": "Auto-suspend: on"
  },
  "privacy": {
    "icon-size": 15,
    "modules": [
      { "type": "screenshare", "tooltip": true },
      { "type": "audio-in", "tooltip": true }
    ]
  },
  "mpris": {
    "format": "{status_icon} {title}",
    "tooltip-format": "󰝚 {title}\n󰀄 {artist}\n(Playing on {player})",
    "status-icons": { "playing": "󰏤", "paused": "󰐊" },
    "max-length": 40
  },
  "tray": {
    "icon-size": 15,
    "spacing": 22
  },
  "group/group-toggles": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 100,
      "transition-left-to-right": false,
      "children-class": "not-toggles"
    },
    "modules": [
      "custom/toggles-arrow",
      "power-profiles-daemon",
      "custom/dark-mode",
      "custom/gammastep"
    ]
  },
  "custom/toggles-arrow": {
    "format": "",
    "tooltip-format": "Toggles"
  },
  "power-profiles-daemon": {
    "format-icons": {
      "power-saver": "󰌪",
      "balanced": "󰗑",
      "performance": "󰓅"
    }
  },
  "custom/dark-mode": {
    "format": "{icon}",
    "format-icons": ["", ""],
    "exec": "~/.local/share/fn-scripts/dark-mode.sh track",
    "on-click": "~/.local/share/fn-scripts/dark-mode.sh toggle",
    "return-type": "json"
  },
  "custom/gammastep": {
    "format": "{icon}",
    "format-icons": ["󱩍", "󱩌"],
    "exec-if": "which gammastep",
    "exec": "~/.config/waybar/scripts/gammastep.sh",
    "signal": 2,
    "on-click": "pkill -SIGUSR1 gammastep",
    "return-type": "json"
  },
  "pulseaudio": {
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "format": "{icon}",
    "tooltip-format": "{desc} {volume}%",
    "format-muted": "󰝟",
    "on-click": "~/.config/waybar/scripts/toggle.sh pavucontrol -t 3",
    "on-click-right": "~/.local/share/fn-scripts/vol_mute.sh toggle",
    "scroll-step": 5
  },
  "bluetooth": {
    "format-on": "󰂯",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format": "{status}",
    "tooltip-format-connected-battery": "{device_alias} 󰁾 {device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/toggle.sh blueman-manager"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-linked": "󰤤",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤫",
    "tooltip-format-linked": "{ifname}",
    "tooltip-format": "{essid}"
  },
  "upower": {
    "format": " {percentage}",
    "format-alt": " {percentage} ({time})",
    "icon-size": 13
  },
  "custom/dnd": {
    "format": "{icon}",
    "format-icons": ["", "󰂛"],
    "exec-if": "which dunstctl",
    "exec": "~/.local/share/fn-scripts/dnd-mode.sh get",
    "on-click": "~/.local/share/fn-scripts/dnd-mode.sh toggle",
    "signal": 1,
    "return-type": "json"
  },
  "clock": {
    "format": "{:%a %d %b %I:%M %p}",
    "calendar": {
      "format": {
        "today": "<b><u>{}</u></b>"
      }
    },
    "tooltip-format": "<tt>{calendar}</tt>",
    "on-click": "dunstctl history-pop",
    "on-click-right": "gnome-calendar"
  }
}
